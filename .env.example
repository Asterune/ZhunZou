# ---------------------------------------------------------------------------
# 准奏 / Zhunzou server configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Shared secret used by bridge / web clients (Authorization: Bearer <token>).
# REQUIRED in production. A dev fallback is used when NODE_ENV != production.
HUB_SECRET_TOKEN=change-me-to-a-long-random-string

# SQLite database file
DATABASE_PATH=./data/zhunzou.db

# Global engineering rules fed to the Meta-Agent
GLOBAL_RULES_PATH=./GLOBAL_RULES.md

# --- Meta-Agent (pluggable) ------------------------------------------------
# provider:
#   openai  OpenAI-compatible /chat/completions (DeepSeek/OpenAI/Ollama/...)
#   http    POST { ticket, rules } to META_AGENT_ENDPOINT, return
#           { canResolve, selectedOption?, reason } — plug any service
#   none    always escalate to a human
META_AGENT_PROVIDER=openai
META_AGENT_ENABLED=true

# provider=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
META_AGENT_MODEL=deepseek-chat
META_AGENT_TIMEOUT_MS=15000

# provider=http
META_AGENT_ENDPOINT=
# Extra JSON headers for either provider, e.g. {"x-api-key":"..."}
META_AGENT_HEADERS=

# --- Human notification channels (pluggable, fan-out) ----------------------
# Comma-separated: webhook,bark,feishu,slack,discord,ntfy,telegram,console
# Default: webhook when WEBHOOK_URL is set, otherwise no notifications.
NOTIFY_CHANNELS=
# NOTIFY_CHANNELS=webhook,bark

# Generic webhook (receives { type, text, ticket })
WEBHOOK_URL=
WEBHOOK_SECRET=

# Bark (iOS)
# BARK_URL=https://api.day.app/YOUR_DEVICE_KEY
BARK_KEY=

# Feishu / Lark incoming webhook
FEISHU_WEBHOOK_URL=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Discord webhook
DISCORD_WEBHOOK_URL=

# ntfy topic
NTFY_URL=
NTFY_TOKEN=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- External plugin modules (optional) ------------------------------------
# Comma-separated JS modules loaded at boot (relative to repo root).
# See docs/PLUGINS.md.
# HUB_PLUGINS=./plugins/audit-log.mjs,./plugins/slack-bridge.mjs
HUB_PLUGINS=

# Default long-poll window (ms) used when the client omits ?timeout=
WAIT_TIMEOUT_MS=40000

# --- One-click approval links (notifications) ------------------------------
# Public origin used to build signed links, e.g. https://hub.example.com
PUBLIC_BASE_URL=
# HMAC key for approval links; defaults to HUB_SECRET_TOKEN when empty.
APPROVAL_LINK_SECRET=
# Link lifetime in ms (1 minute ~ 7 days).
APPROVAL_LINK_TTL_MS=1800000

# --- Timeout auto-resolve (optional, opt-in) -------------------------------
# If > 0, pending tickets expire after this many ms and are resolved with
# their recommended option. Destructive options are never auto-approved.
AUTO_RESOLVE_TIMEOUT_MS=0
# Empty = all projects. Comma-separated project names to limit the policy.
AUTO_RESOLVE_PROJECTS=

# Background sweeper interval for SLA + stale task cleanup.
SWEEP_INTERVAL_MS=5000

# --- Stale task recovery ---------------------------------------------------
# Requeue a CLAIMED task if its env has been offline for this long.
TASK_CLAIM_TIMEOUT_MS=1800000
# Fail a CLAIMED task after this long even if the env is still online.
TASK_HARD_TIMEOUT_MS=21600000
# How many claims before a repeatedly-lost task is marked FAILED.
TASK_MAX_ATTEMPTS=3

# Fail a RUNNING chat message after its env has been offline for this long.
# 0 disables recovery (a dead runner then leaves the turn stuck in RUNNING).
CHAT_MESSAGE_TIMEOUT_MS=300000

# --- Web dashboard (single-port deployment) --------------------------------
# Serve packages/web/dist from the same Fastify server.
SERVE_WEB=true
WEB_DIST_PATH=./packages/web/dist

# Published standalone bridge bundles (pnpm publish:bridge), served publicly at
# /releases/bridge/ with the manifest behind /api/bridge/latest.
BRIDGE_RELEASES_PATH=./release/bridge

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
