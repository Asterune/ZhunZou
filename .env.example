# ---------------------------------------------------------------------------
# 准奏 / Zhunzou server configuration
# Copy to .env and fill in real values. NEVER commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=8787
HOST=0.0.0.0

# Shared secret used by bridge / web clients (Authorization: Bearer <token>).
# REQUIRED in production. A dev fallback is used when NODE_ENV != production.
HUB_SECRET_TOKEN=change-me-to-a-long-random-string

# SQLite database file
DATABASE_PATH=./data/zhunzou.db
# 会话图片默认存放在数据库同级的 chat-uploads/；需要单独挂载时再改。
# CHAT_UPLOAD_DIR=./data/chat-uploads

# Global engineering rules fed to the Meta-Agent
GLOBAL_RULES_PATH=./GLOBAL_RULES.md

# --- Meta-Agent (pluggable) ------------------------------------------------
# provider:
#   openai  OpenAI-compatible /chat/completions (DeepSeek/OpenAI/Ollama/...)
#   http    POST { ticket, rules, mode } to META_AGENT_ENDPOINT, return
#           { canResolve, selectedOption?, confidence?, category?, reason }
#   none    always escalate to a human
META_AGENT_PROVIDER=openai
META_AGENT_ENABLED=true

# provider=openai
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_API_KEY=
META_AGENT_MODEL=deepseek-chat
# Optional second model for the adversarial reviewer. Empty = same model.
META_AGENT_SECOND_MODEL=
META_AGENT_TIMEOUT_MS=15000

# provider=http
META_AGENT_ENDPOINT=
# Extra JSON headers for either provider, e.g. {"x-api-key":"..."}
META_AGENT_HEADERS=

# --- Hub-side judgment (who decides) --------------------------------------
# off    a human rules on everything
# reply  the hub auto-sends an agent's chat reply when the rules allow it,
#        and still opens a ticket for every code-changing next step
# all    the hub also rules on next steps/actions (destructive always asks)
DECISION_POLICY=reply

# --- L2 adjudication limits (auto-approval is not a blank cheque) ----------
# Judge must be at least this sure, or the ticket goes to a human.
DECISION_MIN_CONFIDENCE=0.7
# off | high | all. `high` adds an adversarial reviewer for risky categories.
DECISION_DUAL_REVIEW=high
# Categories that always require the second reviewer to agree.
DECISION_HIGH_RISK_CATEGORIES=dependency,api-contract,schema,product,deploy,security
# Auto-approvals per project per rolling 24h. 0 = no cap.
DECISION_DAILY_QUOTA=0
# Fraction of auto-approvals sampled for a human audit (0 disables sampling).
DECISION_AUDIT_RATE=0.1
# How long an overturned category stays out of auto-approval.
DECISION_DEMOTION_MINUTES=1440

# --- Human notification channels (pluggable, fan-out) ----------------------
# Comma-separated: webhook,bark,feishu,wecom,slack,discord,ntfy,telegram,console
# Default: webhook when WEBHOOK_URL is set, otherwise no notifications.
NOTIFY_CHANNELS=
# NOTIFY_CHANNELS=webhook,bark

# Generic webhook (receives { type, text, ticket })
WEBHOOK_URL=
WEBHOOK_SECRET=

# Bark (iOS)
# BARK_URL=https://api.day.app/YOUR_DEVICE_KEY
BARK_KEY=

# Feishu / Lark incoming webhook
FEISHU_WEBHOOK_URL=

# WeCom (企业微信) group robot webhook
WECOM_WEBHOOK_URL=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# Discord webhook
DISCORD_WEBHOOK_URL=

# ntfy topic
NTFY_URL=
NTFY_TOKEN=

# Telegram bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- External plugin modules (optional) ------------------------------------
# Comma-separated JS modules loaded at boot (relative to repo root).
# See docs/PLUGINS.md.
# HUB_PLUGINS=./plugins/audit-log.mjs,./plugins/slack-bridge.mjs
HUB_PLUGINS=

# Default long-poll window (ms) used when the client omits ?timeout=
WAIT_TIMEOUT_MS=40000

# --- One-click approval links (notifications) ------------------------------
# Public origin used to build signed links, e.g. https://hub.example.com
PUBLIC_BASE_URL=
# HMAC key for approval links; defaults to HUB_SECRET_TOKEN when empty.
APPROVAL_LINK_SECRET=
# Link lifetime in ms (1 minute ~ 7 days).
APPROVAL_LINK_TTL_MS=1800000

# --- Timeout auto-resolve (optional, opt-in) -------------------------------
# If > 0, pending tickets expire after this many ms and are resolved with
# their recommended option. Destructive options are never auto-approved.
AUTO_RESOLVE_TIMEOUT_MS=0
# Empty = all projects. Comma-separated project names to limit the policy.
AUTO_RESOLVE_PROJECTS=

# Background sweeper interval for SLA + stale task cleanup.
SWEEP_INTERVAL_MS=5000

# --- Stale task recovery ---------------------------------------------------
# Requeue a CLAIMED task if its env has been offline for this long.
TASK_CLAIM_TIMEOUT_MS=1800000
# Fail a CLAIMED task after this long even if the env is still online.
TASK_HARD_TIMEOUT_MS=21600000
# How many claims before a repeatedly-lost task is marked FAILED.
TASK_MAX_ATTEMPTS=3

# Fail a RUNNING chat message after its env has been offline for this long.
# 0 disables recovery (a dead runner then leaves the turn stuck in RUNNING).
CHAT_MESSAGE_TIMEOUT_MS=300000

# --- Realtime device gateway ------------------------------------------------
# Devices connect outward over WebSocket; dashboards use a short-lived ticket.
REALTIME_ENABLED=true
# Browser WebSocket ticket lifetime (ms).
REALTIME_TICKET_TTL_MS=60000
# Device heartbeat interval advertised to `zhunzou-device` (ms).
REALTIME_HEARTBEAT_MS=30000
# Close a device socket after this long without a frame (ms).
REALTIME_HEARTBEAT_TIMEOUT_MS=90000

# --- Interactive PTY terminals ----------------------------------------------
# Requires node-pty on the device (optional dependency of @zhunzou/device).
TERMINAL_ENABLED=true
# Global / per-device cap on STARTING/ACTIVE/DETACHED sessions.
TERMINAL_MAX_SESSIONS=32
TERMINAL_MAX_SESSIONS_PER_DEVICE=4
# Close a terminal after this long without input or output (ms).
TERMINAL_IDLE_TIMEOUT_MS=1800000
# Keep a detached session while the device reconnects (ms).
TERMINAL_DETACH_TTL_MS=300000
# In-memory scrollback per terminal session (bytes).
TERMINAL_SCROLLBACK_BYTES=1048576
# Maximum browser viewers per session; only one writer may type at a time.
TERMINAL_MAX_VIEWERS=8
# Per-session input throughput limit (bytes/second).
TERMINAL_INPUT_BYTES_PER_SEC=65536
# Empty = all devices; comma-separated env allowlist otherwise.
TERMINAL_ALLOWED_ENVS=

# --- Web dashboard (single-port deployment) --------------------------------
# Serve packages/web/dist from the same Fastify server.
SERVE_WEB=true
WEB_DIST_PATH=./packages/web/dist

# Published standalone bridge bundles (pnpm publish:bridge), served publicly at
# /releases/bridge/ with the manifest behind /api/bridge/latest.
BRIDGE_RELEASES_PATH=./release/bridge

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=info
