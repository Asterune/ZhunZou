    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@zhunzou/shared": "workspace:*",
    "@fastify/static": "^10.1.8",
    "better-sqlite3": "^11.8.1",
